---
import type { Skill } from '../data/skills';

type Tone = 'paper' | 'accent' | 'ink';

interface Props {
  skill: Skill;
  /** 卡片基调：paper 纸底（默认）、accent 强调绿底、ink 墨面深底 */
  tone?: Tone;
  class?: string;
}

const { skill, tone = 'paper', class: className = '' } = Astro.props;

const SURFACE: Record<Tone, string> = {
  paper: 'bg-ground text-ink',
  accent: 'bg-accent text-accent-ink',
  // 墨面本身已经是最深的一层，卡片再垫一层薄薄的反色才看得出边界
  ink: 'bg-on-ink/8 text-on-ink',
};

const STRONG: Record<Tone, string> = {
  paper: 'text-ink',
  accent: 'text-accent-ink',
  ink: 'text-on-ink',
};

/* 纸底用第二个灰阶做「安静」的层级（在纸底与 band-deep 上都过 AA）；
   有底色的卡片改用透明度，这样换底色不用再挑颜色。 */
const QUIET = tone === 'paper' ? 'text-ink-2' : 'opacity-70';
const QUIET_SOFT = tone === 'paper' ? 'text-ink-2' : 'opacity-65';
/* 徽章永远和卡片底色反着来，任何基调下都看得见 */
const BADGE = tone === 'ink' ? 'bg-on-ink text-ink-surface' : 'bg-ink-surface text-on-ink';
---

<article
  class:list={['flex h-full flex-col justify-between p-6 lg:p-7', SURFACE[tone], className]}
>
  <div>
    <div class="flex flex-wrap items-center gap-2.5">
      <h3 class="text-[1.3rem] font-extrabold leading-none tracking-tight">{skill.label}</h3>
      {skill.badge && (
        <span
          class:list={[
            'px-1.5 py-0.5 text-[0.6875rem] font-bold uppercase tracking-[0.1em]',
            BADGE,
          ]}
        >
          {skill.badge}
        </span>
      )}
    </div>
    <p class="mt-2 text-[0.9rem] font-semibold opacity-70">{skill.tagline}</p>
    <p class="mt-4 text-[0.92rem] leading-relaxed opacity-85">{skill.summary}</p>
    {
      skill.useWhen.length > 0 && (
        <ul class="mt-5 list-none space-y-1.5 p-0 text-[0.875rem] opacity-75">
          {skill.useWhen.map((u) => (
            <li class="flex gap-2.5">
              <span aria-hidden="true" class="mt-[0.55em] size-[5px] shrink-0 bg-current" />
              <span>{u}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="mt-7">
    <p class:list={['text-[0.75rem] font-semibold uppercase tracking-[0.1em]', QUIET]}>安装名</p>
    <p class:list={['mt-1.5 font-mono text-[0.8125rem] break-all', STRONG[tone]]}>
      --skill "{skill.installName}"
    </p>
    <p class:list={['mt-1 font-mono text-[0.6875rem] break-all', QUIET_SOFT]}>
      skills/{skill.folder}
    </p>
  </div>
</article>
