---
import Base from '../layouts/Base.astro';
import { RELEASES } from '../data/changelog';
import { LINKS, SITE } from '../data/site';
---

<Base
  title="更新日志"
  description="Taste Skill 的版本变化：2.0.0 把默认技能换成 v2，并保留 v2-experimental 与 v1；含 v2 的六个步骤、硬性要求、测试结果与成本。"
>
  <section class="mx-auto max-w-[1240px] px-5 pb-12 pt-12 lg:px-8 lg:pb-14 lg:pt-16">
    <h1 class="t-h1 max-w-[16ch]" data-reveal>更新日志</h1>
    <p class="t-lead mt-6 max-w-[56ch]" data-reveal style="--reveal-delay:80ms">
      仓库遵循一种「准语义化」的纪律：实验性预发布自由迭代，稳定版锁定接口。当前版本
      <strong class="font-semibold text-ink">{SITE.version}</strong>，发布于 {SITE.versionDate}。
    </p>
    <p class="t-meta mt-5" data-reveal style="--reveal-delay:140ms">
      本页是上游
      <a href={LINKS.upstreamChangelog} class="link" target="_blank" rel="noopener noreferrer"
        >CHANGELOG.md</a
      >的中文整理版。以英文原文为准。
    </p>
  </section>

  {
    RELEASES.map((release, i) => {
      const isCurrent = release.current === true;
      return (
        <section class:list={[isCurrent ? 'band band-fill' : i % 2 === 1 ? 'band-deep' : '']}>
          <div class="mx-auto max-w-[1240px] px-5 py-14 lg:px-8 lg:py-20">
            <div class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14">
              <div data-reveal class="lg:sticky lg:top-24 lg:self-start">
                <p class="flex flex-wrap items-baseline gap-3">
                  <span class="text-[clamp(2rem,4.5vw,3.2rem)] font-extrabold leading-none tracking-[-0.03em] tabular-nums">
                    {release.version}
                  </span>
                  {isCurrent && (
                    <span class="bg-ink-surface px-2 py-0.5 text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-on-ink">
                      当前版本
                    </span>
                  )}
                </p>
                <p class="t-meta mt-3">{release.date}</p>
                <p class:list={['mt-5 max-w-[36ch] text-[0.95rem] leading-relaxed', isCurrent ? 'opacity-80' : 'text-ink-2']}>
                  {release.summary}
                </p>
              </div>

              <div>
                {release.groups.map((group, gi) => (
                  <div class={gi === 0 ? '' : 'mt-10'} data-reveal style={`--reveal-delay:${gi * 60}ms`}>
                    <h3
                      class:list={[
                        'text-[0.8125rem] font-bold uppercase tracking-[0.12em]',
                        isCurrent ? 'opacity-60' : 'text-ink-2',
                      ]}
                    >
                      {group.heading}
                    </h3>
                    <ul class="mt-4 list-none space-y-2.5 p-0">
                      {group.items.map((item) => (
                        <li class="flex items-start gap-3.5">
                          <span
                            aria-hidden="true"
                            class:list={[
                              'mt-[0.6em] block size-2 shrink-0',
                              isCurrent ? 'bg-accent-ink' : 'bg-accent',
                            ]}
                          />
                          <span
                            class:list={[
                              'max-w-[64ch] text-[0.9375rem] leading-relaxed',
                              isCurrent ? 'opacity-85' : 'text-ink-2',
                            ]}
                          >
                            {item}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}

                {release.groups.length === 0 && (
                  <p
                    class:list={[
                      'max-w-[56ch] text-[0.95rem] leading-relaxed',
                      isCurrent ? 'opacity-80' : 'text-ink-2',
                    ]}
                  >
                    这一版没有分子项的变化记录，仅作为可见的安装名保留。
                  </p>
                )}
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="mx-auto max-w-[1240px] px-5 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] lg:gap-14">
      <h2 class="t-h2 max-w-[20ch]" data-reveal>要不要跟着升？</h2>
      <div data-reveal style="--reveal-delay:100ms">
        <p class="max-w-[56ch] text-[1.02rem] leading-relaxed text-ink-2">
          安装名从没变过，所以升级就是重跑一遍同一条命令。如果你依赖旧版本的确切行为，两个旧版本都还在，各自的安装名也没变。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/install" class="btn btn-ink">安装与升级 <span aria-hidden="true">→</span></a>
          <a href="/skills" class="btn btn-line">全部技能</a>
        </div>
      </div>
    </div>
  </section>
</Base>
