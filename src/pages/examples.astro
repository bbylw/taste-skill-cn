---
import Base from '../layouts/Base.astro';
import { EXAMPLES, EXAMPLE_CREDITS } from '../data/examples';
import { LINKS } from '../data/site';

const spans = ['lg:col-span-12', 'lg:col-span-7', 'lg:col-span-5', 'lg:col-span-12'];
---

<Base
  title="示例"
  description="由 taste-skill v2 构建的页面示例：每张都来自一份简短需求，照片来自开放档案并由技能逐一署名。"
>
  <section class="mx-auto max-w-[1240px] px-5 pb-12 pt-12 lg:px-8 lg:pb-14 lg:pt-16">
    <h1 class="t-h1 max-w-[18ch]" data-reveal>每一个页面，都来自一份简短需求</h1>
    <p class="t-lead mt-6 max-w-[56ch]" data-reveal style="--reveal-delay:80ms">
      下面每一个页面都是一次构建的产物，没有后期排版，也没有补充美术。它们都通过了同一个检查器。
    </p>
    <p class="t-meta mt-5" data-reveal style="--reveal-delay:140ms">
      <a href={EXAMPLE_CREDITS.film} class="link" target="_blank" rel="noopener noreferrer"
        >观看发布影片</a
      >
      · 每张照片的署名见
      <a href={EXAMPLE_CREDITS.link} class="link" target="_blank" rel="noopener noreferrer"
        >CREDITS.md</a
      >
    </p>
  </section>

  <section class="mx-auto max-w-[1240px] px-5 pb-16 lg:px-8 lg:pb-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-6 lg:gap-y-14">
      {
        EXAMPLES.map((ex, i) => (
          <figure class:list={['m-0', spans[i]]} data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
            <div class="overflow-hidden">
              <img
                src={ex.image}
                alt={ex.alt}
                width="1200"
                height="701"
                class="w-full"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            <figcaption class="mt-4">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h2 class="text-[1.25rem] font-extrabold tracking-tight">{ex.title}</h2>
                <p class="t-meta m-0">需求：{ex.brief}</p>
              </div>
              <p class="mt-2 max-w-[56ch] text-[0.95rem] leading-relaxed text-ink-2">
                {ex.caption}
              </p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="band band-fill">
    <div class="mx-auto grid max-w-[1240px] gap-8 px-5 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:px-8">
      <div data-reveal>
        <h2 class="t-h2 max-w-[22ch]">照片是真的，而且都署了名</h2>
        <p class="mt-5 max-w-[56ch] text-[1.02rem] leading-relaxed opacity-80">
          示例里的照片来自 Wikimedia Commons、Openverse、大都会艺术博物馆这类开放档案馆藏，只使用允许商用的许可，并由技能在页面上逐一署名。你有自己的照片时，直接替换掉它们。
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end" data-reveal style="--reveal-delay:100ms">
        <a href="/workflow" class="btn btn-ink">图片来源与检查器 <span aria-hidden="true">→</span></a>
        <a
          href={LINKS.upstreamRepo}
          class="btn btn-line"
          target="_blank"
          rel="noopener noreferrer">上游仓库</a
        >
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1240px] px-5 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
      <h2 class="t-h2 max-w-[18ch]" data-reveal>这几个页面各自用了什么</h2>
      <ul class="list-none p-0" data-reveal style="--reveal-delay:100ms">
        {
          [
            {
              t: 'Böhne & Söhne · 店面',
              d: '方向「又响又平」：平涂的深色底、能找到的最重字体、抠出来的手绘立面。首屏就是一个视觉焦点。',
            },
            {
              t: 'Nachtschicht · 日期',
              d: '方向「接触印相样张」：档案照片做成单色网格，把信息直接压在画面上，而不是挂在旁边。',
            },
            {
              t: 'Böhne & Söhne · 烘焙度',
              d: '方向「大小不一的照片」：四张真实照片逐级放大，用尺度本身讲清四个阶段。',
            },
            {
              t: 'Böhne & Söhne · 柜台问答',
              d: '方向「色彩章节」：整幅色带承担分区，小标签沿对角线错开，取代了编号与细线。',
            },
          ].map((row) => (
            <li class="grid gap-1 py-4 sm:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] sm:gap-8">
              <span class="text-[1.02rem] font-extrabold tracking-tight">{row.t}</span>
              <span class="text-[0.9rem] leading-relaxed text-ink-2">{row.d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
