---
import Base from '../layouts/Base.astro';
import CodeBlock from '../components/CodeBlock.astro';
import SectionHead from '../components/SectionHead.astro';
import { INSTALL_COMMANDS, PLUGIN_COMMANDS } from '../data/install';
import { REQUIREMENTS } from '../data/workflow';
import { LINKS } from '../data/site';
---

<Base
  title="安装"
  description="安装 Taste Skill：npx skills add 一行命令装齐全部技能，或装成 Claude Code / Codex 插件；含 Node 22+ 与 Chrome、Edge、Chromium 的前置要求。"
>
  <section class="mx-auto max-w-[1240px] px-5 pb-12 pt-12 lg:px-8 lg:pb-14 lg:pt-16">
    <h1 class="t-h1 max-w-[16ch]" data-reveal>安装</h1>
    <p class="t-lead mt-6" data-reveal style="--reveal-delay:80ms">
      <a href={LINKS.agentSkillsCli} class="link" target="_blank" rel="noopener noreferrer"
        >npx skills</a
      > CLI 会扫描仓库的 <code class="mono">skills/</code> 目录，因此<strong class="font-semibold text-ink"
        >代码类与图像生成类技能的安装方式完全相同</strong
      >。你也可以把 SKILL.md 直接复制进项目，或粘贴进对话里。
    </p>
  </section>

  <!-- 前置要求 -->
  <section class="band band-fill">
    <div class="mx-auto max-w-[1240px] px-5 py-14 lg:px-8 lg:py-16">
      <h2 class="t-h2 max-w-[20ch]">跑之前，先确认这四件事</h2>
      <dl class="mt-9 grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
        {
          REQUIREMENTS.map((r, i) => (
            <div data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <dt class="text-[0.8125rem] font-bold uppercase tracking-[0.12em] opacity-60">
                {r.label}
              </dt>
              <dd class="m-0 mt-2">
                <span class="block text-[1.35rem] font-extrabold leading-tight tracking-tight">
                  {r.value}
                </span>
                <span class="mt-2 block text-[0.875rem] leading-relaxed opacity-80">{r.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-10 max-w-[70ch] text-[0.9rem] leading-relaxed opacity-75">
        检查器不会安装任何东西：它通过 DevTools 协议驱动你已经装好的浏览器。相对地，如果找不到可用的 Chrome、Edge 或 Chromium，第 5 步「过闸」就跑不起来。
      </p>
    </div>
  </section>

  <!-- 命令行安装 -->
  <section class="mx-auto max-w-[1240px] px-5 py-16 lg:px-8 lg:py-20">
    <SectionHead
      title="用命令行安装"
      lead="三条命令覆盖了绝大多数情况：装全部、只装一个、以及升级。"
    />
    <div class="mt-11 grid gap-10 lg:grid-cols-2 lg:gap-x-14">
      {
        INSTALL_COMMANDS.map((cmd, i) => (
          <div data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <h3 class="text-[1.05rem] font-extrabold tracking-tight">{cmd.label}</h3>
            <p class="mt-2 mb-4 max-w-[58ch] text-[0.875rem] leading-relaxed text-ink-2">
              {cmd.note}
            </p>
            <CodeBlock code={cmd.code} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- 插件安装 -->
  <section class="band-deep">
    <div class="mx-auto max-w-[1240px] px-5 py-16 lg:px-8 lg:py-20">
      <SectionHead
        title="也可以装成编辑器插件"
        lead="如果你在 Claude Code 或 Codex 里工作，整套装成插件更省事：技能都带命名空间前缀，不会和你已有的技能撞名。"
      />
      <div class="mt-11 grid gap-10 lg:grid-cols-3 lg:gap-x-10">
      {
        PLUGIN_COMMANDS.map((cmd, i) => (
          <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <h3 class="text-[1.05rem] font-extrabold tracking-tight">{cmd.label}</h3>
            <p class="mt-2 mb-4 text-[0.875rem] leading-relaxed text-ink-2">{cmd.note}</p>
            <CodeBlock
              code={cmd.code}
              fileLabel={cmd.lang === 'claude' ? 'Claude Code' : cmd.lang === 'codex' ? 'Codex' : 'bash'}
            />
          </div>
        ))
      }
      </div>
    </div>
  </section>

  <!-- 装完之后 -->
  <section class="mx-auto max-w-[1240px] px-5 py-16 lg:px-8 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
      <div data-reveal>
        <h2 class="t-h2 max-w-[18ch]">装完怎么用</h2>
        <p class="mt-5 max-w-[48ch] text-[1.02rem] leading-relaxed text-ink-2">
          技能装好后，Agent 会在相关任务里自动加载它。你也可以在提示词里明确点名，例如「遵循该技能：先盘点，再抽三个方向」。
        </p>
        <p class="mt-6 max-w-[48ch] text-[0.9rem] leading-relaxed text-ink-2">
          想走「先出图、再写码」的流程时，用 image-to-code 技能；想改造一个已有项目，用 redesign 技能。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/skills" class="btn btn-ink">看全部技能 <span aria-hidden="true">→</span></a>
          <a href="/workflow" class="btn btn-line">工作原理</a>
        </div>
      </div>

      <div data-reveal style="--reveal-delay:100ms">
        <h3 class="text-[0.8125rem] font-bold uppercase tracking-[0.12em] text-ink-3">
          常见坑
        </h3>
        <ul class="mt-5 list-none p-0">
          {
            [
              {
                t: '混淆「安装名」和「文件夹名」',
                d: '传给 --skill 的是 SKILL.md 里的 name 字段。目录叫 redesign-skill，安装名却是 redesign-existing-projects。',
              },
              {
                t: '以为 v2 还是一个单文件',
                d: 'v2 是一个文件夹，里面有脚本和方向库。只把 SKILL.md 复制走会丢掉抽牌与检查器。',
              },
              {
                t: '在容器或 CI 里没有浏览器',
                d: 'draw / lint / assets 三个脚本在 Node 18+ 就能跑，但检查器必须有一个真实的 Chrome、Edge 或 Chromium。',
              },
              {
                t: '忘了重新跑安装命令',
                d: '安装名没变过，所以「重跑一次」就是升级；不需要修改任何脚本或配置。',
              },
            ].map((item, i) => (
              <li class="py-4" data-reveal style={`--reveal-delay:${140 + i * 50}ms`}>
                <p class="text-[1rem] font-extrabold tracking-tight">{item.t}</p>
                <p class="mt-1.5 max-w-[56ch] text-[0.9rem] leading-relaxed text-ink-2">{item.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>
